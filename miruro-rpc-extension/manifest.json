{
  "manifest_version": 3,
  "name": "Miruro & VidBox Discord RPC",
  "version": "1.2.0",
  "description": "Standalone Manifest V3 Chrome Extension providing live, permanent Discord Rich Presence for Miruro & VidBox directly through local Discord RPC.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.miruro.tv/*",
    "*://*.miruro.cx/*",
    "*://*.miruro.online/*",
    "*://*.vidbox.wtf/*",
    "*://*.vidbox.to/*",
    "*://*.vidbox.cc/*",
    "*://*.vidbox.ag/*",
    "*://*.vidbox.me/*",
    "*://api.themoviedb.org/*",
    "*://image.tmdb.org/*",
    "*://127.0.0.1/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "discord_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.miruro.tv/*",
        "*://*.miruro.cx/*",
        "*://*.miruro.online/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.vidbox.wtf/*",
        "*://*.vidbox.to/*",
        "*://*.vidbox.cc/*",
        "*://*.vidbox.ag/*",
        "*://*.vidbox.me/*"
      ],
      "js": ["vidbox-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["iframe.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Miruro & VidBox Discord RPC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
